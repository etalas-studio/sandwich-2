# ─────────────────────────────────────────────────────────────
# SANDWICH — environment variables
# Copy to .env and fill in real values. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# ─── Server ───
PORT=4319
DATABASE_URL=postgresql://localhost:5432/sandwich
NODE_ENV=development
# Comma-separated list of trusted host headers. In development,
# localhost:3000 is always added automatically.
TRUSTED_HOSTS=localhost

# ─── Web / Frontend (Vite, build-time) ───
# Set only when the frontend is deployed separately from the API.
# Leave empty for local dev (Vite proxy forwards /api to the backend).
VITE_API_URL=

# ─── PostHog (analytics) ───
# Client-side analytics. Leave VITE_POSTHOG_KEY empty to disable (local dev).
# Set these at build time in the deploy environment (Vite exposes VITE_ vars).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── CORS (cross-origin frontend + backend) ───
# The exact origin allowed to make credentialed cross-origin requests.
# Leave empty unless frontend and backend are on different origins.
CORS_ORIGIN=

# ─── Cookies ───
# Set to 1 to mark the session cookie Secure (HTTPS-only).
COOKIE_SECURE=0

# ─── Email (Resend) ───
# Transactional email for email verification + password reset.
# Get an API key at https://resend.com/api-keys.
RESEND_API_KEY=
# Sender address — must use a domain verified in Resend
# (or onboarding@resend.dev for local testing).
EMAIL_FROM=SANDWICH <onboarding@resend.dev>
# Public base URL used to build verification/reset links.
# Local dev defaults to http://localhost:3000 when unset.
APP_URL=http://localhost:3000

# ─── Deployment / Prototype previews ───
# Optional. When set, prototype preview URLs are built as
# https://<PREVIEW_DOMAIN>/p/<shareId>/ instead of relative /p/... URLs.
PREVIEW_DOMAIN=

# ─── AI Engine (single harness: Pi SDK) ───
# The provider/model per stage (chat / prototype / glowup / vision) is chosen
# in the internal admin panel (/admin → engine settings) and stored in the DB.
# Env vars below are fallbacks/defaults only.

# OpenCode Go provider (built-in). Optional — set to make opencode-go usable.
OPENCODE_API_KEY=

# 9Router provider (registered on startup). Optional — the admin panel can also
# store these in the DB (integration_credentials), which takes precedence.
# NINEROUTER_URL=https://runchise-9router.up.railway.app/v1
# NINEROUTER_KEY=sk-...

# ─── Admin (internal Etalas operator panel) ───
# On first boot the server seeds this account as role=admin (idempotent).
# Change the password after first login.
ADMIN_SEED_EMAIL=admin@sandwich.etalas.com
ADMIN_SEED_PASSWORD=

# ─── Attachment extraction ───
# Optional. Enables screenshotting reference URLs for visual design extraction.
# Free tier at https://screenshotone.com (100 screenshots/month).
SCREENSHOTONE_ACCESS_KEY=
# OCR fallback languages (e.g. "eng" or "eng+ind" for Indonesian).
OCR_LANGS=eng

# ─── Midtrans (optional) ───
# Server key stays backend-only; client key is public (Snap JS).
# When MIDTRANS_SERVER_KEY is empty, the app runs a server-side
# dev simulation (no real Midtrans call) instead of charging.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Single source of truth for the Midtrans environment:
#   false = sandbox (app.sandbox.midtrans.com + sandbox snap.js)
#   true  = production (app.midtrans.com + production snap.js)
MIDTRANS_IS_PRODUCTION=false

# Midtrans dashboard → Settings → Payment Notification URL must point to:
#   https://<your-domain>/api/midtrans/notification
# (public HTTPS, TLS 1.2, no redirect).

# ─── Attachments (Cloudflare R2, S3-compatible) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional public base URL. When set, attachment URLs use it directly;
# otherwise presigned URLs are generated.
R2_PUBLIC_URL=

# ─── Static serving (backend) ───
# Directory with the built frontend. Defaults to apps/web/dist.
# WEB_ROOT=apps/web/dist
