      "@keyframes sonar { 0% { transform: scale(1); opacity: 0.8; } 100% { transform: scale(2.5); opacity: 0; } }"
    ],
    "animate_classes": [
      "animate-letter",
      "animate-marquee",
      "animate-spin-slow"
    ],
    "has_scroll_reveal": true,
    "techniques": [
      "hover-states",
      "group-hover-reveal",
      "transitions",
      "glass-backdrop-blur",
      "scroll-reveal-observer",
      "mix-blend",
      "custom-keyframes"
    ]
  },
  "signature": [
    "glass",
    "big-radius",
    "blend-modes"
  ]
