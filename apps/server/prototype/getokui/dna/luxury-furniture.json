    "h1_sizes": [
      "text-6xl",
      "text-8xl"
    ],
    "cta_classes": "btn-beam dark-btn inline-flex items-center gap-2 bg-[#2C2824] text-[#F2EFEA] px-6 py-3 rounded-full text-sm font-medium transition-transform hover:scale-105"
  },
  "type_scale": {
    "h1": "text-6xl",
    "h2": "text-4xl"
  },
  "spacing": {
    "section_padding": [
      "py-32",
      "pt-40",
      "py-16"
    ],
    "container_max": [
      "max-w-4xl"
    ],
    "gap": [
      "gap-4",
      "gap-8"
    ]
  },
  "radius": [
    "rounded-full",
    "rounded-lg",
    "rounded-2xl"
  ],
  "shadow": [],
  "layout": {
    "hero_layout": "centered",
    "oversized_display_type": true,
    "symmetry": "centered-symmetric",
    "composition_techniques": [
      "marquee",
      "rotated-elements",
      "bento-grid",
      "blend-modes",
      "overlap-offset"
    ]
  },
  "motion": {
    "keyframe_names": [
      "beam",
      "marquee",
      "slideDownLetter",
