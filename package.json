{
  "name": "runchise-agent-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestrator untuk AI dev pipeline Runchise. Menjalankan coding agent per tiket di git worktree terpisah, menegakkan guardrail, dan merekam tiap percobaan.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "selftest": "tsc -p tsconfig.json && node dist/selftest.js",
    "run:queue": "node dist/cli.js run",
    "dashboard": "node dist/cli.js dashboard",
    "doctor": "node dist/cli.js doctor"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3"
  }
}
