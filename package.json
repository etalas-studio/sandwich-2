{
  "name": "sandwich",
  "version": "0.1.0",
  "private": true,
  "description": "SANDWICH — from a messy brief to an execution-ready spec: PRD, prototype, MOM, and quotation in one AI pipeline, with chat follow-ups.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm --prefix apps/web install",
    "build": "tsc -p tsconfig.json && node scripts/copy-getokui.mjs && npm --prefix apps/web run build",
    "dev:web": "npm --prefix apps/web run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node scripts/copy-getokui.mjs && node --test dist/**/*.test.js",
    "format": "prettier --write \"apps/server/**/*.ts\"",
    "lint": "eslint \"apps/server/**/*.ts\"",
    "serve": "node dist/web-server.js",
    "start": "npm run serve"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/busboy": "^1.5.4",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.7.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "mammoth": "^1.12.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "tesseract.js": "^7.0.0"
  }
}
