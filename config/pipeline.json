{
  "repoPath": "../runchise",
  "worktreeRoot": ".work/worktrees",
  "runsRoot": "runs",
  "baseBranch": "master",
  "branchPrefix": "agent/",

  "limits": {
    "maxFilesChanged": 8,
    "maxDiffLines": 300,
    "planTimeoutMs": 600000,
    "implementTimeoutMs": 1200000,
    "rspecTimeoutMs": 1800000,
    "maxCiRetries": 2
  },

  "engine": {
    "name": "claude-code",
    "planAllowedTools": "Read,Grep,Glob",
    "implementAllowedTools": "Read,Grep,Glob,Edit,Write,Bash",
    "plan": {
      "bin": "claude",
      "args": [
        "-p",
        "{{prompt}}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--allowedTools",
        "{{allowedTools}}",
        "--max-turns",
        "30"
      ]
    },
    "implement": {
      "bin": "claude",
      "args": [
        "-p",
        "{{prompt}}",
        "--output-format",
        "stream-json",
        "--verbose",
        "--allowedTools",
        "{{allowedTools}}",
        "--max-turns",
        "80"
      ]
    }
  },

  "rspecCommand": {
    "bin": "bundle",
    "args": ["exec", "rspec", "--format", "json", "--out", "{{outFile}}", "{{targets}}"]
  },

  "laneRules": {
    "lane1Enabled": false,
    "lane1MaxDiffLines": 50,
    "lane1RequiresNewTests": true,
    "coveredPathPrefixes": [
      "app/helpers/",
      "app/domains/excel_generators/"
    ]
  },

  "blocklist": [
    { "pattern": "app/domains/accounting/", "reason": "domain akuntansi — menyentuh angka uang klien" },
    { "pattern": "app/domains/jurnal/", "reason": "jurnal akuntansi — rasio tes 3%, tidak ada jaring keselamatan" },
    { "pattern": "db/migrate/", "reason": "migrasi database — tidak reversibel dengan aman" },

    { "pattern": "app/domains/grab_food/", "reason": "integrasi pihak ketiga" },
    { "pattern": "app/domains/grab_express/", "reason": "integrasi pihak ketiga" },
    { "pattern": "app/domains/gobiz/", "reason": "integrasi pihak ketiga" },
